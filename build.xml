<?xml version="1.0" encoding="UTF-8"?>

<project name="ThinkingRock" basedir=".">
    <description>Builds trgtd distributions.</description>
    <property file="nbproject/platform.properties"/>
    <ant antfile="nbproject/platform.xml" target="prepare"/>
    <import file="nbproject/build-impl.xml"/>

    <property name="windows.jdk.cache.dir" location="netbeans-plat/downloads"/>
    <property name="windows.jdk.archive" location="${windows.jdk.cache.dir}/${windows-jdk-archive-name}"/>
    <property name="windows.jdk.dir" location="netbeans-plat/windows-jdk-${windows-jdk-version}"/>
    <property name="windows.runtime.stage.dir" location="build/windows-x64"/>
    <property name="linux.jdk.archive" location="${windows.jdk.cache.dir}/${linux-jdk-archive-name}"/>
    <property name="linux.jdk.dir" location="netbeans-plat/linux-jdk-${linux-jdk-version}"/>
    <property name="linux.runtime.stage.dir" location="build/linux-x64"/>
    <property name="rcedit.file" location="netbeans-plat/downloads/rcedit-x64.exe"/>
    <property name="windows.app.icon" location="nbproject/trgtd.ico"/>

    <target name="branding" depends="-init" if="run.branding">
        <property name="generated.branding.dir" location="${suite.build.dir}/branding"/>
        <delete dir="${generated.branding.dir}"/>
        <copy todir="${generated.branding.dir}">
            <fileset dir="${branding.dir}"/>
        </copy>
        <copy file="${branding.dir}/modules/org-netbeans-core.jar/org/netbeans/core/ui/Bundle.properties"
              tofile="${generated.branding.dir}/modules/org-netbeans-core.jar/org/netbeans/core/ui/Bundle.properties"
              overwrite="true">
            <filterset>
                <filter token="NETBEANS_PLATFORM_VERSION" value="${netbeans-plat-version}"/>
            </filterset>
        </copy>
        <mkdir dir="${cluster}"/>
        <branding cluster="${cluster}" overrides="${generated.branding.dir}"
                  token="${branding.token}" locales="${branding.locales.impl}"/>
    </target>

    <target name="-detect-windows-resource-editor">
        <condition property="windows.resource.editor.supported">
            <or>
                <os family="windows"/>
                <available file="/proc/sys/fs/binfmt_misc/WSLInterop"/>
            </or>
        </condition>
    </target>

    <target name="-prepare-windows-resource-editor"
            depends="-detect-windows-resource-editor"
            if="windows.resource.editor.supported">
        <mkdir dir="${windows.jdk.cache.dir}"/>
        <get src="${rcedit-url}" dest="${rcedit.file}" skipexisting="true"/>
        <checksum file="${rcedit.file}" algorithm="SHA-256" property="rcedit.actual.sha256"/>
        <condition property="rcedit.checksum.valid">
            <equals arg1="${rcedit.actual.sha256}" arg2="${rcedit-sha256}"/>
        </condition>
        <fail message="rcedit SHA-256 mismatch. Delete ${rcedit.file}, then retry.">
            <condition><not><istrue value="${rcedit.checksum.valid}"/></not></condition>
        </fail>
        <chmod file="${rcedit.file}" perm="755" osfamily="unix"/>
    </target>

    <target name="-brand-windows-launchers"
            depends="-prepare-windows-resource-editor,suite.build-launchers"
            if="windows.resource.editor.supported">
        <exec executable="${rcedit.file}" failonerror="true">
            <arg path="${build.launcher.dir}/bin/${app.name}.exe"/>
            <arg value="--set-icon"/>
            <arg path="${windows.app.icon}"/>
        </exec>
        <exec executable="${rcedit.file}" failonerror="true">
            <arg path="${build.launcher.dir}/bin/${app.name}64.exe"/>
            <arg value="--set-icon"/>
            <arg path="${windows.app.icon}"/>
        </exec>
    </target>

    <target name="build-launchers" depends="-brand-windows-launchers">
        <!-- NetBeans launchers derive the app name from architecture-specific filenames. -->
        <copy file="${build.launcher.dir}/bin/${app.name}.exe"
              tofile="${build.launcher.dir}/bin/${app.name}32.exe"
              overwrite="true"/>
        <delete file="${build.launcher.dir}/bin/${app.name}.exe"/>
        <copy file="nbproject/${app.name}.cmd"
              tofile="${build.launcher.dir}/bin/${app.name}.cmd"
              overwrite="true"/>
        <fixcrlf file="${build.launcher.dir}/bin/${app.name}.cmd" eol="crlf"/>
    </target>

    <target name="-check-windows-jdk">
        <loadfile property="windows.jdk.verified.sha256"
                  srcFile="${windows.jdk.dir}/.verified-distribution"
                  failonerror="false">
            <filterchain>
                <striplinebreaks/>
                <tokenfilter>
                    <trim/>
                </tokenfilter>
            </filterchain>
        </loadfile>
        <condition property="windows.jdk.ready">
            <and>
                <equals arg1="${windows.jdk.verified.sha256}" arg2="${windows-jdk-sha256}"/>
                <available file="${windows.jdk.dir}/bin/jlink.exe"/>
                <available file="${windows.jdk.dir}/lib/modules"/>
            </and>
        </condition>
    </target>

    <target name="-prepare-windows-jdk" depends="-check-windows-jdk" unless="windows.jdk.ready">
        <mkdir dir="${windows.jdk.cache.dir}"/>
        <get src="${windows-jdk-url}" dest="${windows.jdk.archive}" skipexisting="true"/>
        <checksum file="${windows.jdk.archive}" algorithm="SHA-256" property="windows.jdk.actual.sha256"/>
        <condition property="windows.jdk.checksum.valid">
            <equals arg1="${windows.jdk.actual.sha256}" arg2="${windows-jdk-sha256}"/>
        </condition>
        <fail message="Windows JDK SHA-256 mismatch. Delete ${windows.jdk.archive}, then retry.">
            <condition><not><istrue value="${windows.jdk.checksum.valid}"/></not></condition>
        </fail>
        <delete dir="${windows.jdk.dir}"/>
        <mkdir dir="${windows.jdk.dir}"/>
        <unzip src="${windows.jdk.archive}" dest="${windows.jdk.dir}">
            <cutdirsmapper dirs="1"/>
        </unzip>
        <echo file="${windows.jdk.dir}/.verified-distribution">${windows-jdk-sha256}</echo>
    </target>

    <target name="build-windows-self-contained"
            depends="build-zip,-prepare-windows-jdk"
            description="Builds a Windows x64 ZIP with a stripped private Java runtime.">
        <property name="windows.runtime.image.dir"
                  location="${windows.runtime.stage.dir}/${app.name}/runtime"/>
        <delete dir="${windows.runtime.stage.dir}"/>
        <mkdir dir="${windows.runtime.stage.dir}"/>
        <unzip src="${dist.dir}/${app.name}.zip" dest="${windows.runtime.stage.dir}"/>
        <exec executable="powershell.exe" failonerror="true">
            <arg value="-NoProfile"/>
            <arg value="-NonInteractive"/>
            <arg value="-ExecutionPolicy"/>
            <arg value="Bypass"/>
            <arg value="-Command"/>
            <arg value="$script = '${basedir}/nbproject/build-windows-runtime.ps1'; if ($script.StartsWith('/')) { $script = (wsl.exe wslpath -w $script).Trim() }; &amp; $script -JdkDir '${windows.jdk.dir}' -ModulePath '${windows.jdk.dir}/jmods' -OutputDir '${windows.runtime.image.dir}' -Modules '${windows-runtime-modules}'; exit $LASTEXITCODE"/>
        </exec>
        <fail message="The Windows runtime is incomplete: java.exe or jvm.dll is missing.">
            <condition>
                <not>
                    <and>
                        <available file="${windows.runtime.image.dir}/bin/java.exe"/>
                        <available file="${windows.runtime.image.dir}/bin/server/jvm.dll"/>
                    </and>
                </not>
            </condition>
        </fail>
        <echo file="${windows.runtime.stage.dir}/${app.name}/etc/${app.name}.conf"
              append="true">jdkhome="runtime"
</echo>
        <zip destfile="${dist.dir}/${app.name}-windows-x64.zip">
            <zipfileset dir="${windows.runtime.stage.dir}"/>
        </zip>
        <echo>Created self-contained Windows package: ${dist.dir}/${app.name}-windows-x64.zip</echo>
    </target>

    <target name="-check-linux-jdk">
        <loadfile property="linux.jdk.verified.sha256"
                  srcFile="${linux.jdk.dir}/.verified-distribution"
                  failonerror="false">
            <filterchain>
                <striplinebreaks/>
            </filterchain>
        </loadfile>
        <condition property="linux.jdk.ready">
            <and>
                <equals arg1="${linux.jdk.verified.sha256}" arg2="${linux-jdk-sha256}"/>
                <available file="${linux.jdk.dir}/bin/jlink"/>
                <available file="${linux.jdk.dir}/lib/modules"/>
            </and>
        </condition>
    </target>

    <target name="-prepare-linux-jdk" depends="-check-linux-jdk" unless="linux.jdk.ready">
        <mkdir dir="${windows.jdk.cache.dir}"/>
        <get src="${linux-jdk-url}" dest="${linux.jdk.archive}" skipexisting="true"/>
        <checksum file="${linux.jdk.archive}" algorithm="SHA-256" property="linux.jdk.actual.sha256"/>
        <condition property="linux.jdk.checksum.valid">
            <equals arg1="${linux.jdk.actual.sha256}" arg2="${linux-jdk-sha256}"/>
        </condition>
        <fail message="Linux JDK SHA-256 mismatch. Delete ${linux.jdk.archive}, then retry.">
            <condition><not><istrue value="${linux.jdk.checksum.valid}"/></not></condition>
        </fail>
        <delete dir="${linux.jdk.dir}"/>
        <mkdir dir="${linux.jdk.dir}"/>
        <!-- Native tar keeps the executable bits that Ant's untar drops. -->
        <exec executable="tar" failonerror="true">
            <arg value="-xzf"/>
            <arg file="${linux.jdk.archive}"/>
            <arg value="-C"/>
            <arg file="${linux.jdk.dir}"/>
            <arg value="--strip-components=1"/>
        </exec>
        <echo file="${linux.jdk.dir}/.verified-distribution">${linux-jdk-sha256}</echo>
    </target>

    <target name="build-linux-self-contained"
            depends="build-zip,-prepare-linux-jdk"
            description="Builds a Linux x64 tar.gz with a stripped private Java runtime.">
        <property name="linux.runtime.image.dir"
                  location="${linux.runtime.stage.dir}/${app.name}/runtime"/>
        <delete dir="${linux.runtime.stage.dir}"/>
        <mkdir dir="${linux.runtime.stage.dir}"/>
        <exec executable="unzip" failonerror="true">
            <arg value="-q"/>
            <arg file="${dist.dir}/${app.name}.zip"/>
            <arg value="-d"/>
            <arg file="${linux.runtime.stage.dir}"/>
        </exec>
        <chmod file="${linux.runtime.stage.dir}/${app.name}/bin/${app.name}" perm="755"/>
        <exec executable="${linux.jdk.dir}/bin/jlink" failonerror="true">
            <arg value="--module-path"/>
            <arg file="${linux.jdk.dir}/jmods"/>
            <arg value="--add-modules"/>
            <arg value="${linux-runtime-modules}"/>
            <arg value="--output"/>
            <arg file="${linux.runtime.image.dir}"/>
            <arg value="--strip-debug"/>
            <arg value="--no-header-files"/>
            <arg value="--no-man-pages"/>
            <arg value="--compress"/>
            <arg value="zip-6"/>
            <arg value="--include-locales"/>
            <arg value="en,de,es,fr,nl"/>
        </exec>
        <fail message="The Linux runtime is incomplete: java or libawt_xawt.so is missing.">
            <condition>
                <not>
                    <and>
                        <available file="${linux.runtime.image.dir}/bin/java"/>
                        <available file="${linux.runtime.image.dir}/lib/libawt_xawt.so"/>
                    </and>
                </not>
            </condition>
        </fail>
        <echo file="${linux.runtime.stage.dir}/${app.name}/etc/${app.name}.conf"
              append="true">jdkhome="runtime"
</echo>
        <delete file="${dist.dir}/${app.name}-linux-x64.tar.gz"/>
        <exec executable="tar" failonerror="true">
            <arg value="-czf"/>
            <arg file="${dist.dir}/${app.name}-linux-x64.tar.gz"/>
            <arg value="-C"/>
            <arg file="${linux.runtime.stage.dir}"/>
            <arg value="${app.name}"/>
        </exec>
        <echo>Created self-contained Linux package: ${dist.dir}/${app.name}-linux-x64.tar.gz</echo>
    </target>

    <target name="run-dev" depends="build" description="Runs ThinkingRock without the NetBeans IDE. Back up production data first.">
        <ant antfile="modules/au.com.trgtd.tr.calendar/build.xml" target="run"/>
    </target>

    <target name="-bundle-osx" depends="build,build-launchers" description="Builds an application bundle for MacOSX.">

        <!-- create app directories -->
        <mkdir dir="${app.dir}"/>
        <mkdir dir="${app.dir}/Contents"/>
        <mkdir dir="${app.dir}/Contents/MacOS"/>
        <mkdir dir="${app.dir}/Contents/Resources"/>
        
        <!-- app icon -->
        <copy file="${app.icns}" tofile="${app.dir}/Contents/Resources/${app.name}.icns"/>

        <!-- executable -->
        <copy todir="${app.dir}/Contents/Resources/${app.name}/bin" 
              file ="${build.launcher.dir}/bin/${app.name}">
        </copy>
        <chmod file="${app.dir}/Contents/Resources/${app.name}/bin/${app.name}" 
               perm="755">
        </chmod>
        
        <!-- app executable -->
        <symlink link="${app.dir}/Contents/MacOS/${app.name}" 
                 resource="../Resources/${app.name}/bin/${app.name}">
        </symlink>
        
        <!-- etc -->
        <copy todir="${app.dir}/Contents/Resources/${app.name}/etc">
            <fileset dir="${build.launcher.dir}/etc/" />
        </copy>
        <copy tofile="${app.dir}/Contents/Resources/${app.name}/etc/${app.name}.conf"
              file="${app.conf}"
              overwrite="true">
        </copy>

        <!-- cluster -->        
        <subant genericantfile="${harness.dir}/suite.xml" target="copy-cluster" inheritrefs="true">
            <property name="dest.dir"   value="${app.dir}/Contents/Resources/${app.name}"/>
            <property name="nbexec.dir" value="${app.dir}/Contents/Resources/${app.name}"/>
            <property name="build.dir"  value="${suite.build.dir}"/>
            <resources refid="zip.platform.clusters"/>
        </subant>
        <copy todir="${app.dir}/Contents/Resources/${app.name}/${app.name}">            
            <fileset dir="${cluster}"/>
        </copy>        
        <!-- set execute permission for NB executer -->
        <chmod dir="${app.dir}/Contents/Resources/${app.name}/platform/lib" 
               includes="nbexec" 
               perm="755">
        </chmod>

        <!-- app Info.plist -->
        <copy file="${harness.dir}/etc/Info.plist" tofile="${app.dir}/Contents/Info.plist">
            <filterchain>
                <replacestring from="$${app.name}" to="${app.name}"/>
                <replacestring from="$${app.version}" to="${app.version}"/>
                <replacestring from="$${app.title}" to="${app.title}"/>
                <replacestring from="$${app.icon}" to="master.png"/>
                <replacestring from="$${branding.token}" to="${branding.token}"/>
            </filterchain>
        </copy>
        
        <!-- Remove unnecessary stuff -->
        <!-- remove Windows exe and dll files -->
        <delete verbose="true">
            <fileset dir="${app.dir}/Contents/Resources/${app.name}" includes="**/*.exe,**/*.dll"/>
        </delete>
        
    </target>  

    <target name="-package-osx" depends="" description="Builds an application bundle for MacOSX.">

        <!-- move dist/trgtd.app to dist/ThinkingRock/trgtd.app -->
        <mkdir dir="${dst.dir}/${app.title}"/>
        <!--<move file="${dst.dir}/${app.name}.app" tofile="${dst.dir}/${app.title}/${app.title}.app" verbose="true"/>-->        
        <move file="${app.dir}" tofile="${dst.dir}/${app.title}/${app.title}.app" verbose="true"/>        
        
        <exec executable="/usr/bin/pkgbuild">
            <arg value="--root"/>            
            <arg value="${dst.dir}/${app.title}"/>
            <arg value="--identifier"/>            
            <arg value="${app.id}"/>
            <arg value="--version"/>            
            <arg value="${app.version}"/>            
            <arg value="--install-location"/>            
            <arg value="/Applications"/>            
            <arg value="${dst.dir}/temp.pkg"/>            
        </exec>                        
        
        <copy file="${pkg.dir}/productbuild/dist.xml" tofile="${dst.dir}/dist.xml" verbose="true"/>        

        <exec dir="${dst.dir}" executable="/usr/bin/productbuild">
            <arg value="--distribution"/>            
            <arg value="dist.xml"/>
            
            <arg value="--resources"/>            
            <arg value="${pkg.dir}/productbuild/resources"/>
            <arg value="--version"/>            
            <arg value="${app.version}"/>            
                        
            <arg value="--package-path"/>            
            <arg value="temp.pkg"/>
            <arg value="${pkg.name}.pkg"/>            
        </exec>                        

        <!-- Sign installer -->
        <!-- productsign - -sign "Developer ID Installer: Avente Pty Ltd (VTLL493375)" my.pkg my-signed.pkg-->
        <exec dir="${dst.dir}" executable="/usr/bin/productsign">
            <arg value="--sign"/>            
            <arg value="Developer ID Installer: Avente Pty Ltd (VTLL493375)"/>            
            <arg value="${pkg.name}.pkg"/>            
            <arg value="${pkg.name}-signed.pkg"/>            
        </exec>                        


        <!-- clean up -->
        <delete dir="${dst.dir}/${app.title}"/>
        <delete file="${dst.dir}/dist.xml"/>
        <delete file="${dst.dir}/temp.pkg"/>
                  
        <echo>Created MacOSX package: ${dst.dir}/${pkg.name}.pkg</echo>                                                                                                                                
    
    </target>
    
    
</project>
