<?xml version="1.0" encoding="UTF-8"?>
<project name="platform" default="prepare" basedir="..">
    <property file="nbproject/platform.properties"/>
    <property name="platform.cache.dir" location="netbeans-plat/downloads"/>
    <property name="platform.archive" location="${platform.cache.dir}/netbeans-${netbeans-plat-version}-bin.zip"/>

    <target name="check-toolchain">
        <fail message="Use JDK ${java-version} (not a JRE). Set JAVA_HOME and PATH; current Java is ${java.version}.">
            <condition>
                <not>
                    <and>
                        <equals arg1="${ant.java.version}" arg2="${java-version}"/>
                        <or>
                            <available file="${java.home}/bin/javac"/>
                            <available file="${java.home}/bin/javac.exe"/>
                        </or>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Use Apache Ant ${ant-minimum-version} or newer; current Ant is ${ant.version}.">
            <condition>
                <not><antversion atleast="${ant-minimum-version}"/></not>
            </condition>
        </fail>
    </target>

    <target name="check-platform" depends="check-toolchain">
        <loadfile property="platform.verified.sha256" srcFile="${nbplatform.active.dir}/.verified-distribution" failonerror="false">
            <filterchain>
                <striplinebreaks/>
                <tokenfilter>
                    <trim/>
                </tokenfilter>
            </filterchain>
        </loadfile>
        <condition property="platform.ready">
            <and>
                <equals arg1="${platform.verified.sha256}" arg2="${netbeans.distribution.sha256}"/>
                <available file="${harness.dir}/suite.xml"/>
                <available file="${nbplatform.active.dir}/platform/core/core.jar"/>
                <available file="${nbplatform.active.dir}/ide/modules/org-netbeans-modules-projectapi-nb.jar"/>
            </and>
        </condition>
    </target>

    <target name="download" depends="check-platform" unless="platform.ready">
        <mkdir dir="${platform.cache.dir}"/>
        <get src="${netbeans.distribution.url}" dest="${platform.archive}" skipexisting="true"/>
        <checksum file="${platform.archive}" algorithm="SHA-256" property="platform.actual.sha256"/>
        <condition property="platform.checksum.valid">
            <equals arg1="${platform.actual.sha256}" arg2="${netbeans.distribution.sha256}"/>
        </condition>
        <fail message="NetBeans archive SHA-256 mismatch. Delete ${platform.archive}, then retry.">
            <condition><not><istrue value="${platform.checksum.valid}"/></not></condition>
        </fail>
        <delete dir="${nbplatform.active.dir}"/>
        <unzip src="${platform.archive}" dest="${nbplatform.active.dir}">
            <patternset>
                <include name="netbeans/harness/**"/>
                <include name="netbeans/platform/**"/>
                <include name="netbeans/ide/**"/>
            </patternset>
            <cutdirsmapper dirs="1"/>
        </unzip>
        <chmod dir="${nbplatform.active.dir}/platform/lib" includes="nbexec" perm="755" osfamily="unix"/>
        <echo file="${nbplatform.active.dir}/.verified-distribution">${netbeans.distribution.sha256}</echo>
    </target>

    <target name="prepare" depends="download"/>
</project>
