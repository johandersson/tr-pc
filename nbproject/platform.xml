<?xml version="1.0" encoding="UTF-8"?>
<project name="platform" default="prepare" basedir="..">
    <property file="nbproject/platform.properties"/>
    <property name="platform.cache.dir" location="netbeans-plat/downloads"/>
    <property name="platform.archive" location="${platform.cache.dir}/netbeans-${netbeans-plat-version}-bin.zip"/>
    <property name="javahelp.runtime.archive" location="${platform.cache.dir}/jhall-2.0_05.jar"/>
    <property name="javahelp.license.file" location="${platform.cache.dir}/jhall-2.0_05-license.txt"/>
    <property name="javahelp.module.jar" location="${nbplatform.active.dir}/platform/modules/org-netbeans-modules-javahelp.jar"/>

    <target name="check-toolchain">
        <fail message="Use JDK ${java-version} or newer (not a JRE). Set JAVA_HOME and PATH; current Java is ${java.version}.">
            <condition>
                <not>
                    <and>
                        <javaversion atleast="${java-version}"/>
                        <or>
                            <available file="${java.home}/bin/javac"/>
                            <available file="${java.home}/bin/javac.exe"/>
                        </or>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Use Apache Ant ${ant-minimum-version} or newer; current Ant is ${ant.version}.">
            <condition>
                <not><antversion atleast="${ant-minimum-version}"/></not>
            </condition>
        </fail>
    </target>

    <target name="check-platform" depends="check-toolchain">
        <loadfile property="platform.verified.sha512" srcFile="${nbplatform.active.dir}/.verified-distribution" failonerror="false">
            <filterchain>
                <striplinebreaks/>
                <tokenfilter>
                    <trim/>
                </tokenfilter>
            </filterchain>
        </loadfile>
        <condition property="platform.ready">
            <and>
                <equals arg1="${platform.verified.sha512}" arg2="${netbeans.distribution.sha512}"/>
                <available file="${harness.dir}/suite.xml"/>
                <available file="${nbplatform.active.dir}/platform/core/core.jar"/>
                <available file="${nbplatform.active.dir}/ide/modules/org-netbeans-modules-projectapi-nb.jar"/>
            </and>
        </condition>
    </target>

    <target name="download" depends="check-platform" unless="platform.ready">
        <mkdir dir="${platform.cache.dir}"/>
        <get src="${netbeans.distribution.url}" dest="${platform.archive}" skipexisting="true"/>
        <checksum file="${platform.archive}" algorithm="SHA-512" property="platform.actual.sha512"/>
        <condition property="platform.checksum.valid">
            <equals arg1="${platform.actual.sha512}" arg2="${netbeans.distribution.sha512}"/>
        </condition>
        <fail message="NetBeans archive SHA-512 mismatch. Delete ${platform.archive}, then retry.">
            <condition><not><istrue value="${platform.checksum.valid}"/></not></condition>
        </fail>
        <delete dir="${nbplatform.active.dir}"/>
        <unzip src="${platform.archive}" dest="${nbplatform.active.dir}">
            <patternset>
                <include name="netbeans/harness/**"/>
                <include name="netbeans/platform/**"/>
                <include name="netbeans/ide/**"/>
            </patternset>
            <cutdirsmapper dirs="1"/>
        </unzip>
        <chmod dir="${nbplatform.active.dir}/platform/lib" includes="nbexec" perm="755" osfamily="unix"/>
        <echo file="${nbplatform.active.dir}/.verified-distribution">${netbeans.distribution.sha512}</echo>
    </target>

    <target name="check-javahelp" depends="download">
        <condition property="javahelp.ready">
            <resourcecount count="2">
                <zipfileset src="${javahelp.module.jar}"
                            includes="javax/help/JHelp.class,META-INF/LICENSE.javahelp"/>
            </resourcecount>
        </condition>
    </target>

    <target name="prepare-javahelp" depends="check-javahelp" unless="javahelp.ready">
        <get src="${javahelp.runtime.url}" dest="${javahelp.runtime.archive}" skipexisting="true"/>
        <checksum file="${javahelp.runtime.archive}" algorithm="SHA-256" property="javahelp.runtime.actual.sha256"/>
        <fail message="JavaHelp SHA-256 mismatch. Delete ${javahelp.runtime.archive}, then retry.">
            <condition>
                <not><equals arg1="${javahelp.runtime.actual.sha256}" arg2="${javahelp.runtime.sha256}"/></not>
            </condition>
        </fail>
        <get src="${javahelp.license.url}" dest="${javahelp.license.file}" skipexisting="true"/>
        <checksum file="${javahelp.license.file}" algorithm="SHA-256" property="javahelp.license.actual.sha256"/>
        <fail message="JavaHelp license SHA-256 mismatch. Delete ${javahelp.license.file}, then retry.">
            <condition>
                <not><equals arg1="${javahelp.license.actual.sha256}" arg2="${javahelp.license.sha256}"/></not>
            </condition>
        </fail>
        <!-- NetBeans compiles against JavaHelp but omits its GPL runtime from the binary distribution. -->
        <jar destfile="${javahelp.module.jar}" update="true">
            <zipfileset src="${javahelp.runtime.archive}" excludes="META-INF/**"/>
            <zipfileset file="${javahelp.license.file}" fullpath="META-INF/LICENSE.javahelp"/>
        </jar>
        <touch file="${nbplatform.active.dir}/platform/.lastModified"/>
    </target>

    <target name="verify-javahelp" depends="prepare-javahelp">
        <fail message="JavaHelp runtime is unavailable in ${javahelp.module.jar}.">
            <condition>
                <not>
                    <available classname="javax.help.JHelp"
                               classpath="${javahelp.module.jar}" ignoresystemclasses="true"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="prepare" depends="verify-javahelp"/>
</project>
